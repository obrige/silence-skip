{
  "manifest_version": 3,
  "name": "Silence Skip",
  "version": "1.0.0",
  "description": "Smart silence detection and skipping for video/audio. Non-speedup acceleration.",
  "author": "GH_USERNAME",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Silence Skip",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "GH_USERNAME@users.noreply.github.com",
      "strict_min_version": "115.0"
    }
  }
}
